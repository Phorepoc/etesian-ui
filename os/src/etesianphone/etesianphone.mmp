// etesianphone.mmp -- the Etesian dialler (pilot of the shell-tagged apps, docs/phorepoc/etesian-port.md 17): number pad, call log, N9 styling.
#include <platform_paths.hrh>

TARGET			etesianphone.exe
TARGETTYPE		exe
UID				0x100039CE 0xE7016B53

CAPABILITY		NetworkServices LocalServices ReadUserData WriteUserData UserEnvironment SwEvent
VENDORID		0
EPOCHEAPSIZE	0x10000 0x400000

SOURCEPATH		.
SOURCE			etesianphone.cpp

START RESOURCE	etesianphone.rss
HEADER
TARGETPATH		/resource/apps
END

START RESOURCE	etesianphone_reg.rss
TARGETPATH		/private/10003a3f/apps
END

USERINCLUDE		.
APP_LAYER_SYSTEMINCLUDE
OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE

LIBRARY			euser.lib apparc.lib cone.lib eikcore.lib eikcoctl.lib avkon.lib efsrv.lib bafl.lib fbscli.lib gdi.lib ws32.lib bitgdi.lib
LIBRARY			etel3rdparty.lib logcli.lib

EPOCSTACKSIZE	0x8000
