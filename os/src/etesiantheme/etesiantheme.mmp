// etesiantheme.mmp -- test utility: set the active theme from the command line (see etesiantheme.cpp)
#include <platform_paths.hrh>

TARGET			etesiantheme.exe
TARGETTYPE		exe
UID				0x100039CE 0xE7016B54
CAPABILITY		ReadDeviceData WriteDeviceData
VENDORID		0

SOURCEPATH		.
SOURCE			etesiantheme.cpp

USERINCLUDE		.
APP_LAYER_SYSTEMINCLUDE
OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE

LIBRARY			euser.lib centralrepository.lib aknskinsrv.lib
