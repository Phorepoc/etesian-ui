// etesianhome.mmp -- the Etesian Home application (the shell's idle application: Applications view). Plain CONE/Avkon, no Qt.
#include <platform_paths.hrh>

TARGET			etesianhome.exe
TARGETTYPE		exe
UID				0x100039CE 0xE7016B50

CAPABILITY		ReadDeviceData WriteDeviceData NetworkServices LocalServices ReadUserData WriteUserData UserEnvironment SwEvent
VENDORID		0
EPOCHEAPSIZE	0x10000 0x1000000

SOURCEPATH		.
SOURCE			etesianhome.cpp

START RESOURCE	etesianhome.rss
HEADER
TARGETPATH		/resource/apps
END

START RESOURCE	etesianhome_reg.rss
TARGETPATH		/private/10003a3f/apps
END

USERINCLUDE		.
APP_LAYER_SYSTEMINCLUDE
OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE

LIBRARY			euser.lib apparc.lib apgrfx.lib cone.lib eikcore.lib eikcoctl.lib avkon.lib
LIBRARY			efsrv.lib bafl.lib fbscli.lib gdi.lib ws32.lib bitgdi.lib aknskins.lib aknicon.lib centralrepository.lib msgs.lib

EPOCSTACKSIZE	0x8000
