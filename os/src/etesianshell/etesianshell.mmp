// etesianshell.mmp -- "Etesian shell": a small visible application that chooses the UI shell for the next start (Etesian or the stock
// Symbian^3 one). It works on any image, with or without the Control Panel's UI-shell item.
#include <platform_paths.hrh>

TARGET			etesianshell.exe
TARGETTYPE		exe
UID				0x100039CE 0xE7016B52

CAPABILITY		PowerMgmt ReadDeviceData WriteDeviceData NetworkServices LocalServices ReadUserData WriteUserData UserEnvironment SwEvent
VENDORID		0
EPOCHEAPSIZE	0x10000 0x200000

SOURCEPATH		.
SOURCE			etesianshell.cpp

START RESOURCE	etesianshell.rss
HEADER
TARGETPATH		/resource/apps
END

START RESOURCE	etesianshell_reg.rss
TARGETPATH		/private/10003a3f/apps
END

USERINCLUDE		.
APP_LAYER_SYSTEMINCLUDE
OS_LAYER_SYSTEMINCLUDE
MW_LAYER_SYSTEMINCLUDE

LIBRARY			euser.lib apparc.lib cone.lib eikcore.lib eikcoctl.lib avkon.lib centralrepository.lib starterclient.lib
LIBRARY			efsrv.lib bafl.lib fbscli.lib gdi.lib ws32.lib bitgdi.lib

EPOCSTACKSIZE	0x8000
